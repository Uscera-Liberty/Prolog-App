# =====================================================================
#  SPARQL UPDATE-аналоги SWRL-правил R01–R22 (для веб-приложения)
#
#  rdflib не исполняет SWRL, поэтому приложение при старте выполняет этот
#  файл целиком:   graph.update(text)   — повторяя, пока число троек растёт
#  (2–3 прохода: правила R16 и R20 зависят от результатов других правил).
#  Результат совпадает с выводом Pellet (проверено scripts/check_queries.py).
#  Файл .owl при этом НЕ изменяется — выводы живут только в памяти.
# =====================================================================
PREFIX reh: <http://www.semanticweb.org/rehab/ontologies/2026/rehab-program#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# R01 ДиагнозПациента: Пациент → ДанныеПациента → Диагноз  ⇒  имеетДиагноз
INSERT { ?p reh:имеетДиагноз ?dg }
WHERE  { ?p a reh:Пациент ; reh:имеетДанные ?d . ?d reh:содержитДиагноз ?dg } ;

# R02 ПорогиВеса: вес, при котором ИМТ = 25 и = 30 (ИМТ = вес / (рост/100)²)
INSERT { ?p reh:весПриИМТ25 ?a ; reh:весПриИМТ30 ?b }
WHERE  { ?p a reh:Пациент ; reh:ростСм ?h .
         BIND (?h * ?h * 0.0025 AS ?a)
         BIND (?h * ?h * 0.003 AS ?b) } ;

# R03 Ожирение: ИМТ ≥ 30  ⇔  вес ≥ 0,003·рост²
INSERT { ?p a reh:ПациентСОжирением }
WHERE  { ?p a reh:Пациент ; reh:весКг ?w ; reh:ростСм ?h .
         FILTER (?w >= ?h * ?h * 0.003) } ;

# R04 Избыточный вес: 25 ≤ ИМТ < 30
INSERT { ?p a reh:ПациентСИзбыточнымВесом }
WHERE  { ?p a reh:Пациент ; reh:весКг ?w ; reh:ростСм ?h .
         FILTER (?w >= ?h * ?h * 0.0025 && ?w < ?h * ?h * 0.003) } ;

# R05 Пожилой пациент: возраст ≥ 60
INSERT { ?p a reh:ПожилойПациент }
WHERE  { ?p a reh:Пациент ; reh:возраст ?a . FILTER (?a >= 60) } ;

# R06 Подходит по показанию
INSERT { ?p reh:подходитУпражнение ?u }
WHERE  { ?p reh:имеетДанные/reh:содержитДиагноз ?dg .
         ?s reh:показаноПри ?dg . ?u reh:имеетПоказание ?s } ;

# R07 Подходит по цели
INSERT { ?p reh:подходитУпражнение ?u }
WHERE  { ?p reh:имеетДанные/reh:содержитДиагноз ?dg .
         ?dg reh:требуетЦели ?g . ?u reh:влияетНа ?g } ;

# R08 Противопоказано при диагнозе пациента
INSERT { ?p reh:неРекомендуетсяУпражнение ?u }
WHERE  { ?p reh:имеетДанные/reh:содержитДиагноз ?dg .
         ?u reh:имеетПротивопоказание ?c . ?c reh:противопоказаноПри ?dg } ;

# R09 Слишком сложно: сложность > подготовка + 1
INSERT { ?p reh:неРекомендуетсяУпражнение ?u }
WHERE  { ?p a reh:Пациент ; reh:уровеньПодготовки ?l .
         ?u a reh:Упражнение ; reh:уровеньСложности ?s .
         FILTER (?s > ?l + 1) } ;

# R10 Ожирение → сложность ≤ 2   (условие ИМТ ≥ 30 продублировано, чтобы не зависеть от порядка)
INSERT { ?p reh:неРекомендуетсяУпражнение ?u }
WHERE  { ?p a reh:Пациент ; reh:весКг ?w ; reh:ростСм ?h .
         FILTER (?w >= ?h * ?h * 0.003)
         ?u a reh:Упражнение ; reh:уровеньСложности ?s . FILTER (?s > 2) } ;

# R11 Пожилой → сложность ≤ 2
INSERT { ?p reh:неРекомендуетсяУпражнение ?u }
WHERE  { ?p a reh:Пациент ; reh:возраст ?a . FILTER (?a >= 60)
         ?u a reh:Упражнение ; reh:уровеньСложности ?s . FILTER (?s > 2) } ;

# R12 Эффективное упражнение: эффективность ≥ 80 %
INSERT { ?u a reh:ЭффективноеУпражнение }
WHERE  { ?u reh:основаноНаИспытании/reh:показываетЭффективность/reh:процентЭффективности ?v .
         FILTER (?v >= 80) } ;

# R13 Безопасное упражнение: балл ≥ 4
INSERT { ?u a reh:БезопасноеУпражнение }
WHERE  { ?u reh:основаноНаИспытании/reh:определяетУровеньБезопасности/reh:баллБезопасности ?v .
         FILTER (?v >= 4) } ;

# R14 Оптимальное = эффективное И безопасное
INSERT { ?u a reh:ОптимальноеУпражнение }
WHERE  { ?u reh:основаноНаИспытании ?t .
         ?t reh:показываетЭффективность/reh:процентЭффективности ?e ;
            reh:определяетУровеньБезопасности/reh:баллБезопасности ?b .
         FILTER (?e >= 80 && ?b >= 4) } ;

# R15 С осторожностью: испытание приостановлено
INSERT { ?u a reh:УпражнениеСОсторожностью }
WHERE  { ?u reh:основаноНаИспытании/reh:имеетСтатус reh:Статус_Приостановлено } ;

# R16 Программа с риском (использует результат R08–R11 — нужен второй проход)
INSERT { ?pr a reh:ПрограммаСРиском }
WHERE  { ?pr reh:предназначенаДля ?p ; reh:содержитУпражнение ?u .
         ?p reh:неРекомендуетсяУпражнение ?u } ;

# R17 Рекомендуемый специалист — врач
INSERT { ?p reh:рекомендуемыйСпециалист ?s }
WHERE  { ?p reh:имеетДанные/reh:содержитДиагноз ?dg .
         ?s a reh:Реабилитолог ; reh:специализируетсяНа ?dg } ;

# R18 Рекомендуемый специалист — тренер (если диагноз не требует врача)
INSERT { ?p reh:рекомендуемыйСпециалист ?s }
WHERE  { ?p reh:имеетДанные/reh:содержитДиагноз ?dg .
         ?dg reh:требуетВрача false .
         ?s a reh:Тренер ; reh:специализируетсяНа ?dg } ;

# R19 Цель пациента
INSERT { ?p reh:рекомендуемаяЦель ?g }
WHERE  { ?p reh:имеетДанные/reh:содержитДиагноз ?dg . ?dg reh:требуетЦели ?g } ;

# R20 Нужен инвентарь (использует результат R06–R07 — нужен второй проход)
INSERT { ?p reh:нуженИнвентарь ?i }
WHERE  { ?p reh:подходитУпражнение ?u . ?u reh:требуетИнвентарь ?i } ;

# R21 Бюджетный инвентарь: цена ≤ 5000
INSERT { ?i a reh:БюджетныйИнвентарь }
WHERE  { ?i a reh:СпортивныйИнвентарь ; reh:цена ?c . FILTER (?c <= 5000) } ;

# R22 Опытный специалист: стаж ≥ 10
INSERT { ?s a reh:ОпытныйСпециалист }
WHERE  { ?s reh:стажЛет ?y . FILTER (?y >= 10) }
