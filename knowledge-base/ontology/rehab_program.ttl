        owl:FunctionalProperty ;
    rdfs:label "весПриИМТ30"@ru ;
    rdfs:comment "Вес (кг), при котором ИМТ = 30 для роста пациента. [выводится SWRL-правилом R02]"@ru ;
    rdfs:domain reh:Пациент ;
    rdfs:range xsd:decimal .

