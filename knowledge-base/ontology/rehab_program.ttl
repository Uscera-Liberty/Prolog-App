@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reh: <http://www.semanticweb.org/rehab/ontologies/2026/rehab-program#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/rehab/ontologies/2026/rehab-program> a owl:Ontology ;
    rdfs:label "Подбор оптимальной реабилитационной программы"@ru ;
    rdfs:comment "Вариант 22. Рекомендательная система: по диагнозу и данным пациента подбирает упражнения, готовую программу, специалиста (реабилитолога/тренера) и спортивный инвентарь. Содержит SWRL-правила (вкладка SWRLTab)."@ru .

reh:R01_ДиагнозПациента a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R01_ДиагнозПациента"@ru ;
    rdfs:comment "Цепочка Пациент → ДанныеПациента → Диагноз сокращается до прямой связи имеетДиагноз."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:Пациент ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#d> ;
                swrl:propertyPredicate reh:имеетДанные ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#d> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:содержитДиагноз ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:имеетДиагноз ] ) .

reh:R02_ПорогиВеса a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R02_ПорогиВеса"@ru ;
    rdfs:comment "ИМТ = вес / (рост/100)², значит ИМТ = 25 при весе 0,0025·рост², ИМТ = 30 при весе 0,003·рост². Деления нет намеренно: swrlb:divide в SWRLTab (Drools) падает на бесконечных дробях."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:Пациент ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#h> ;
                swrl:propertyPredicate reh:ростСм ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#h2> <urn:swrl#h> <urn:swrl#h> ) ;
                swrl:builtin swrlb:multiply ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#a> <urn:swrl#h2> 0.0025 ) ;
                swrl:builtin swrlb:multiply ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#b> <urn:swrl#h2> 0.003 ) ;
                swrl:builtin swrlb:multiply ] ) ;
    swrl:head ( [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#a> ;
                swrl:propertyPredicate reh:весПриИМТ25 ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#b> ;
                swrl:propertyPredicate reh:весПриИМТ30 ] ) .

reh:R03_Ожирение a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R03_Ожирение"@ru ;
    rdfs:comment "ИМТ ≥ 30, то есть вес ≥ весПриИМТ30."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:Пациент ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#w> ;
                swrl:propertyPredicate reh:весКг ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#b> ;
                swrl:propertyPredicate reh:весПриИМТ30 ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#w> <urn:swrl#b> ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:ПациентСОжирением ] ) .

reh:R04_ИзбыточныйВес a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R04_ИзбыточныйВес"@ru ;
    rdfs:comment "25 ≤ ИМТ < 30."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:Пациент ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#w> ;
                swrl:propertyPredicate reh:весКг ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#a> ;
                swrl:propertyPredicate reh:весПриИМТ25 ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#b> ;
                swrl:propertyPredicate reh:весПриИМТ30 ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#w> <urn:swrl#a> ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#w> <urn:swrl#b> ) ;
                swrl:builtin swrlb:lessThan ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:ПациентСИзбыточнымВесом ] ) .

reh:R05_ПожилойПациент a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R05_ПожилойПациент"@ru ;
    rdfs:comment "Возраст ≥ 60 лет."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:Пациент ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#a> ;
                swrl:propertyPredicate reh:возраст ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#a> 60 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:ПожилойПациент ] ) .

reh:R06_ПодходитПоПоказанию a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R06_ПодходитПоПоказанию"@ru ;
    rdfs:comment "Упражнение показано при диагнозе пациента."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:имеетДиагноз ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:показаноПри ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#s> ;
                swrl:propertyPredicate reh:имеетПоказание ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:подходитУпражнение ] ) .

reh:R07_ПодходитПоЦели a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R07_ПодходитПоЦели"@ru ;
    rdfs:comment "Упражнение влияет на цель, которую требует диагноз пациента."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:имеетДиагноз ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#dg> ;
                swrl:argument2 <urn:swrl#g> ;
                swrl:propertyPredicate reh:требуетЦели ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#g> ;
                swrl:propertyPredicate reh:влияетНа ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:подходитУпражнение ] ) .

reh:R08_Противопоказано a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R08_Противопоказано"@ru ;
    rdfs:comment "У упражнения есть противопоказание при диагнозе пациента."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:имеетДиагноз ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#c> ;
                swrl:propertyPredicate reh:имеетПротивопоказание ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#c> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:противопоказаноПри ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:неРекомендуетсяУпражнение ] ) .

reh:R09_СлишкомСложно a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R09_СлишкомСложно"@ru ;
    rdfs:comment "Сложность упражнения больше уровня подготовки пациента + 1."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:Пациент ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#l> ;
                swrl:propertyPredicate reh:уровеньПодготовки ] [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:Упражнение ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#s> ;
                swrl:propertyPredicate reh:уровеньСложности ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#max> <urn:swrl#l> 1 ) ;
                swrl:builtin swrlb:add ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#s> <urn:swrl#max> ) ;
                swrl:builtin swrlb:greaterThan ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:неРекомендуетсяУпражнение ] ) .

reh:R10_ОжирениеИСложность a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R10_ОжирениеИСложность"@ru ;
    rdfs:comment "При ожирении — только упражнения сложности ≤ 2."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:ПациентСОжирением ] [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:Упражнение ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#s> ;
                swrl:propertyPredicate reh:уровеньСложности ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#s> 2 ) ;
                swrl:builtin swrlb:greaterThan ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:неРекомендуетсяУпражнение ] ) .

reh:R11_ВозрастИСложность a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R11_ВозрастИСложность"@ru ;
    rdfs:comment "Пожилым — только упражнения сложности ≤ 2."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:classPredicate reh:ПожилойПациент ] [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:Упражнение ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#s> ;
                swrl:propertyPredicate reh:уровеньСложности ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#s> 2 ) ;
                swrl:builtin swrlb:greaterThan ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:неРекомендуетсяУпражнение ] ) .

reh:R12_ЭффективноеУпражнение a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R12_ЭффективноеУпражнение"@ru ;
    rdfs:comment "Эффективность по испытанию ≥ 80 %."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#t> ;
                swrl:propertyPredicate reh:основаноНаИспытании ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#t> ;
                swrl:argument2 <urn:swrl#e> ;
                swrl:propertyPredicate reh:показываетЭффективность ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#e> ;
                swrl:argument2 <urn:swrl#v> ;
                swrl:propertyPredicate reh:процентЭффективности ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#v> 80 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:ЭффективноеУпражнение ] ) .

reh:R13_БезопасноеУпражнение a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R13_БезопасноеУпражнение"@ru ;
    rdfs:comment "Балл безопасности по испытанию ≥ 4."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#t> ;
                swrl:propertyPredicate reh:основаноНаИспытании ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#t> ;
                swrl:argument2 <urn:swrl#b> ;
                swrl:propertyPredicate reh:определяетУровеньБезопасности ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#b> ;
                swrl:argument2 <urn:swrl#v> ;
                swrl:propertyPredicate reh:баллБезопасности ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#v> 4 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:БезопасноеУпражнение ] ) .

reh:R14_ОптимальноеУпражнение a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R14_ОптимальноеУпражнение"@ru ;
    rdfs:comment "Эффективное и безопасное одновременно."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:ЭффективноеУпражнение ] [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:БезопасноеУпражнение ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:ОптимальноеУпражнение ] ) .

reh:R15_СОсторожностью a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R15_СОсторожностью"@ru ;
    rdfs:comment "Испытание упражнения приостановлено."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#t> ;
                swrl:propertyPredicate reh:основаноНаИспытании ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#t> ;
                swrl:argument2 reh:Статус_Приостановлено ;
                swrl:propertyPredicate reh:имеетСтатус ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:classPredicate reh:УпражнениеСОсторожностью ] ) .

reh:R16_ПрограммаСРиском a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R16_ПрограммаСРиском"@ru ;
    rdfs:comment "В программе есть упражнение, не рекомендованное её пациенту."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#pr> ;
                swrl:argument2 <urn:swrl#p> ;
                swrl:propertyPredicate reh:предназначенаДля ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#pr> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:содержитУпражнение ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:неРекомендуетсяУпражнение ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#pr> ;
                swrl:classPredicate reh:ПрограммаСРиском ] ) .

reh:R17_СпециалистВрач a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R17_СпециалистВрач"@ru ;
    rdfs:comment "Реабилитолог, специализирующийся на диагнозе пациента."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:имеетДиагноз ] [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:classPredicate reh:Реабилитолог ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:специализируетсяНа ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#s> ;
                swrl:propertyPredicate reh:рекомендуемыйСпециалист ] ) .

reh:R18_СпециалистТренер a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R18_СпециалистТренер"@ru ;
    rdfs:comment "Тренер — только если диагноз не требует врача."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:имеетДиагноз ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#dg> ;
                swrl:argument2 false ;
                swrl:propertyPredicate reh:требуетВрача ] [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:classPredicate reh:Тренер ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:специализируетсяНа ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#s> ;
                swrl:propertyPredicate reh:рекомендуемыйСпециалист ] ) .

reh:R19_ЦельПациента a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R19_ЦельПациента"@ru ;
    rdfs:comment "Цель реабилитации следует из диагноза."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#dg> ;
                swrl:propertyPredicate reh:имеетДиагноз ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#dg> ;
                swrl:argument2 <urn:swrl#g> ;
                swrl:propertyPredicate reh:требуетЦели ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#g> ;
                swrl:propertyPredicate reh:рекомендуемаяЦель ] ) .

reh:R20_НуженИнвентарь a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R20_НуженИнвентарь"@ru ;
    rdfs:comment "Инвентарь для подходящих пациенту упражнений."@ru ;
    swrl:body ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#u> ;
                swrl:propertyPredicate reh:подходитУпражнение ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#u> ;
                swrl:argument2 <urn:swrl#i> ;
                swrl:propertyPredicate reh:требуетИнвентарь ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#i> ;
                swrl:propertyPredicate reh:нуженИнвентарь ] ) .

reh:R21_БюджетныйИнвентарь a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R21_БюджетныйИнвентарь"@ru ;
    rdfs:comment "Цена ≤ 5000 ₽."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#i> ;
                swrl:classPredicate reh:СпортивныйИнвентарь ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#i> ;
                swrl:argument2 <urn:swrl#c> ;
                swrl:propertyPredicate reh:цена ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#c> 5000 ) ;
                swrl:builtin swrlb:lessThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#i> ;
                swrl:classPredicate reh:БюджетныйИнвентарь ] ) .

reh:R22_ОпытныйСпециалист a owl:NamedIndividual,
        swrl:Imp ;
    rdfs:label "R22_ОпытныйСпециалист"@ru ;
    rdfs:comment "Стаж ≥ 10 лет."@ru ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:classPredicate reh:Специалист ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:argument2 <urn:swrl#y> ;
                swrl:propertyPredicate reh:стажЛет ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( <urn:swrl#y> 10 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:classPredicate reh:ОпытныйСпециалист ] ) .

