reh:уровеньСложности a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "уровеньСложности"@ru ;
    rdfs:comment "1 — очень лёгкое … 4 — сложное."@ru ;
    rdfs:domain reh:Упражнение ;
