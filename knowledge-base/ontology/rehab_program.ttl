    rdfs:comment "ИМТ ≥ 30 — ограничение сложности упражнений. [выводимый класс: заполняется SWRL-правилами]"@ru ;
    rdfs:subClassOf reh:Пациент .

reh:Показание_ГиподинамияИЛишнийВес a reh:Показание,
        owl:NamedIndividual ;
    reh:описание "Гиподинамия и избыточная масса тела"^^xsd:string ;
    reh:показаноПри reh:Диагноз_АртрозКолена,
        reh:Диагноз_Гипертония .

reh:Показание_СлабостьМышцСтопы a reh:Показание,
        owl:NamedIndividual ;
    reh:описание "Слабость мышц стопы, уплощение свода"^^xsd:string ;
    reh:показаноПри reh:Диагноз_Плоскостопие .

reh:Производитель_Starfit a reh:Производитель,
        owl:NamedIndividual ;
    reh:задаётХарактеристику reh:Характеристика_Балансировочная_Подушка,
        reh:Характеристика_Гантель_2кг,
        reh:Характеристика_Гиря_8кг ;
    reh:название "Starfit"^^xsd:string ;
    reh:страна "Россия"^^xsd:string .

reh:Статус_Проводится a reh:СтатусИспытания,
        owl:NamedIndividual ;
    rdfs:label "Проводится"@ru ;
    reh:название "Проводится"^^xsd:string .

reh:УлучшениеКачестваЖизни a owl:Class ;
    rdfs:label "УлучшениеКачестваЖизни"@ru ;
    rdfs:comment "Общая цель программы."@ru ;
    rdfs:subClassOf reh:ЦельРеабилитации .

reh:УменьшениеБоли a owl:Class ;
    rdfs:label "УменьшениеБоли"@ru ;
    rdfs:comment "Цели, связанные со снижением боли."@ru ;
    rdfs:subClassOf reh:УлучшениеКачестваЖизни .

reh:Упр_Велотренажёр a reh:Упражнение,
        owl:NamedIndividual ;
    reh:влияетНа reh:Цель_ПрофилактикаОсложненийГипертонии ;
    reh:длительностьМин 15 ;
    reh:имеетПоказание reh:Показание_ГиподинамияИЛишнийВес ;
    reh:имеетТехникуВыполнения reh:Техника_Велотренажёр ;
    reh:имеетЭффект reh:Эффект_Выносливость ;
    reh:количествоПовторений 1 ;
    reh:количествоПодходов 1 ;
    reh:название "Занятие на велотренажёре"^^xsd:string ;
    reh:основаноНаИспытании reh:Испытание_Кардио_2024 ;
    reh:требуетИнвентарь reh:Велотренажёр ;
    reh:уровеньСложности 2 .

reh:Упр_ЯгодичныйМостик a reh:Упражнение,
        owl:NamedIndividual ;
    reh:влияетНа reh:Цель_УменьшениеБолиВСпине ;
    reh:длительностьМин 6 ;
    reh:имеетПобочныйЭффект reh:ПобЭффект_ПовышениеДавления ;
    reh:имеетПоказание reh:Показание_ХроническаяБольВСпине ;
    reh:имеетПротивопоказание reh:Противопоказание_НеконтролируемаяГипертензия ;
    reh:имеетТехникуВыполнения reh:Техника_ЯгодичныйМостик ;
    reh:имеетЭффект reh:Эффект_УкреплениеМышцБедра ;
    reh:количествоПовторений 12 ;
    reh:количествоПодходов 3 ;
    reh:название "Ягодичный мостик"^^xsd:string ;
    reh:основаноНаИспытании reh:Испытание_ЛФК_Спина_2023 ;
    reh:уровеньСложности 2 .

reh:Эффект_Выносливость a reh:ЛечебныйЭффект,
        owl:NamedIndividual ;
    reh:описание "Повышение сердечно-сосудистой выносливости"^^xsd:string .

reh:Эффект_УкреплениеМышцБедра a reh:ЛечебныйЭффект,
