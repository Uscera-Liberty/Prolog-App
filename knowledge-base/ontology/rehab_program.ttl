reh:Испытание_ЛФК_Спина_2023 a reh:КлиническоеИспытание,
        owl:NamedIndividual ;
    reh:датаНачала "2023-02-01T00:00:00"^^xsd:dateTime ;
    reh:имеетСтатус reh:Статус_Завершено ;
    reh:описываетЭффект reh:ПобЭффект_БольВПояснице,
        reh:ПобЭффект_ПовышениеДавления ;
    reh:определяетУровеньБезопасности reh:Безопасность_Испытание_ЛФК_Спина_2023 ;
    reh:подтверждаетЦель reh:Цель_УменьшениеБолиВСпине ;
    reh:показываетЭффективность reh:Эффективность_Испытание_ЛФК_Спина_2023 ;
    reh:фиксируетРеакциюПациента reh:Реакция_Испытание_ЛФК_Спина_2023 ;
    reh:числоУчастников 120 .

