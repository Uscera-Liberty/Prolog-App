    rdfs:domain reh:КлиническоеИспытание ;
    rdfs:range reh:РезультатИспытания .

reh:основаноНаИспытании a owl:ObjectProperty ;
    rdfs:label "основаноНаИспытании"@ru ;
    rdfs:comment "На схеме: «основаны на»."@ru ;
