<urn:swrl#dg> a swrl:Variable .

<urn:swrl#s> a swrl:Variable .

reh:Диагноз a owl:Class ;
    rdfs:label "Диагноз"@ru ;
    rdfs:comment "Установленный диагноз (код МКБ-10)."@ru ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty reh:требуетЦели ;
            owl:someValuesFrom reh:ЦельРеабилитации ],
        reh:МедицинскаяИнформация .

reh:РеабилитационнаяПрограмма a owl:Class ;
    rdfs:label "РеабилитационнаяПрограмма"@ru ;
    rdfs:comment "Подобранная для пациента программа реабилитации (центральное понятие)."@ru ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty reh:содержитУпражнение ;
            owl:someValuesFrom reh:Упражнение ],
        [ a owl:Restriction ;
            owl:onProperty reh:основанаНаИсторииБолезни ;
            owl:someValuesFrom reh:ИсторияБолезни ],
        [ a owl:Restriction ;
            owl:onClass reh:Пациент ;
            owl:onProperty reh:предназначенаДля ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty reh:имеетЦель ;
            owl:someValuesFrom reh:ЦельРеабилитации ],
        owl:Thing .

reh:ДанныеПациента a owl:Class ;
    rdfs:label "ДанныеПациента"@ru ;
    rdfs:comment "Совокупность медицинских сведений о пациенте."@ru ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty reh:содержитДиагноз ;
            owl:someValuesFrom reh:Диагноз ],
        owl:Thing .

reh:ТехникаВыполнения a owl:Class ;
    rdfs:label "ТехникаВыполнения"@ru ;
    rdfs:comment "Правильная техника выполнения упражнения."@ru ;
    rdfs:subClassOf reh:СвойствоУпражнения .

reh:КлиническоеИспытание a owl:Class ;
    rdfs:label "КлиническоеИспытание"@ru ;
    rdfs:comment "Испытание, подтверждающее эффективность и безопасность упражнения."@ru ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass reh:СтатусИспытания ;
            owl:onProperty reh:имеетСтатус ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing .

reh:СпортивныйИнвентарь a owl:Class ;
    rdfs:label "СпортивныйИнвентарь"@ru ;
    rdfs:comment "Инвентарь, необходимый для выполнения упражнения."@ru ;
    rdfs:subClassOf owl:Thing .

<urn:swrl#u> a swrl:Variable .

reh:Пациент a owl:Class ;
    rdfs:label "Пациент"@ru ;
    rdfs:comment "Человек, для которого подбирается программа. [добавлено при доработке]"@ru ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass reh:ДанныеПациента ;
            owl:onProperty reh:имеетДанные ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing .

reh:Упражнение a owl:Class ;
    rdfs:label "Упражнение"@ru ;
    rdfs:comment "Отдельное упражнение, входящее в программу."@ru ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty reh:имеетЭффект ;
            owl:someValuesFrom reh:ЛечебныйЭффект ],
        [ a owl:Restriction ;
            owl:onProperty reh:имеетТехникуВыполнения ;
            owl:someValuesFrom reh:ТехникаВыполнения ],
        owl:Thing .

<urn:swrl#p> a swrl:Variable .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:Диагноз reh:ИсторияБолезни reh:ИндивидуальнаяОсобенность ) .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:Тренер reh:Реабилитолог ) .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:РеабилитационнаяПрограмма reh:Упражнение reh:СвойствоУпражнения reh:Пациент reh:ДанныеПациента reh:МедицинскаяИнформация reh:Специалист reh:ЦельРеабилитации reh:КлиническоеИспытание reh:РезультатИспытания reh:СтатусИспытания reh:СпортивныйИнвентарь reh:Производитель reh:Автор reh:ХарактеристикаИнвентаря reh:ПравилаПользования ) .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:УменьшениеБоли reh:ВосстановлениеПослеТравмы reh:ПрофилактикаХроническихЗаболеваний ) .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:Эффективность reh:УровеньБезопасности reh:РеакцияПациента ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( reh:Статус_Планируется reh:Статус_Проводится reh:Статус_Завершено reh:Статус_Приостановлено ) .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:ПациентСИзбыточнымВесом reh:ПациентСОжирением ) .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:Противопоказание reh:Показание reh:ТехникаВыполнения reh:Эффект ) .

[] a owl:AllDisjointClasses ;
    owl:members ( reh:ЛечебныйЭффект reh:ПобочныйЭффект ) .

