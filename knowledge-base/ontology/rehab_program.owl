<owl:DatatypeProperty rdf:about="#страна">
  <rdfs:domain rdf:resource="#Производитель"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="ru">страна</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ростСм">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Пациент"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">ростСм</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#уровеньПодготовки">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Пациент"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">уровеньПодготовки</rdfs:label>
  <rdfs:comment xml:lang="ru">Физическая подготовка 1–5 (1 — минимальная).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#стажЛет">
  <rdfs:domain rdf:resource="#Специалист"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">стажЛет</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#кодМКБ">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Диагноз"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="ru">кодМКБ</rdfs:label>
  <rdfs:comment xml:lang="ru">Код МКБ-10.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#баллБезопасности">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#УровеньБезопасности"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">баллБезопасности</rdfs:label>
  <rdfs:comment xml:lang="ru">1–5.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#количествоПовторений">
  <rdfs:domain rdf:resource="#Упражнение"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">количествоПовторений</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#требуетВрача">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Диагноз"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label xml:lang="ru">требуетВрача</rdfs:label>
  <rdfs:comment xml:lang="ru">true — программу должен вести врач-реабилитолог, а не тренер.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#название">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="ru">название</rdfs:label>
  <rdfs:comment xml:lang="ru">Название (программы, упражнения, диагноза, инвентаря).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#возраст">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Пациент"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">возраст</rdfs:label>
  <rdfs:comment xml:lang="ru">Полных лет на 01.10.2026.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#занятийВНеделю">
  <rdfs:domain rdf:resource="#РеабилитационнаяПрограмма"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">занятийВНеделю</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#длительностьНедель">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#РеабилитационнаяПрограмма"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">длительностьНедель</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#датаРождения">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Пациент"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:label xml:lang="ru">датаРождения</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#пол">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Пациент"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="ru">пол</rdfs:label>
  <rdfs:comment xml:lang="ru">«Мужской» / «Женский».</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#рейтинг">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Специалист"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">рейтинг</rdfs:label>
  <rdfs:comment xml:lang="ru">Оценка пациентов 1–5.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ФИО">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="ru">ФИО</rdfs:label>
  <rdfs:comment xml:lang="ru">ФИО пациента, специалиста или автора.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#цена">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#СпортивныйИнвентарь"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">цена</rdfs:label>
  <rdfs:comment xml:lang="ru">Рубли.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#телефон">
  <rdfs:domain rdf:resource="#Пациент"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="ru">телефон</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#процентЭффективности">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Эффективность"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">процентЭффективности</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#количествоПодходов">
  <rdfs:domain rdf:resource="#Упражнение"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">количествоПодходов</rdfs:label>
</owl:DatatypeProperty>

<owl:Class rdf:about="#ВосстановлениеПослеТравмы">
  <rdfs:subClassOf rdf:resource="#УлучшениеКачестваЖизни"/>
  <rdfs:label xml:lang="ru">ВосстановлениеПослеТравмы</rdfs:label>
  <rdfs:comment xml:lang="ru">Реабилитация после травмы, операции, инсульта.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#КлиническоеИспытание">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#имеетСтатус"/>
      <owl:onClass rdf:resource="#СтатусИспытания"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="ru">КлиническоеИспытание</rdfs:label>
  <rdfs:comment xml:lang="ru">Испытание, подтверждающее эффективность и безопасность упражнения.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#СпортивныйИнвентарь">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="ru">СпортивныйИнвентарь</rdfs:label>
  <rdfs:comment xml:lang="ru">Инвентарь, необходимый для выполнения упражнения.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ПравилаПользования">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="ru">ПравилаПользования</rdfs:label>
  <rdfs:comment xml:lang="ru">Правила безопасного пользования инвентарём.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ТехникаВыполнения">
  <rdfs:subClassOf rdf:resource="#СвойствоУпражнения"/>
  <rdfs:label xml:lang="ru">ТехникаВыполнения</rdfs:label>
  <rdfs:comment xml:lang="ru">Правильная техника выполнения упражнения.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ДанныеПациента">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#содержитДиагноз"/>
      <owl:someValuesFrom rdf:resource="#Диагноз"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="ru">ДанныеПациента</rdfs:label>
  <rdfs:comment xml:lang="ru">Совокупность медицинских сведений о пациенте.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#РеабилитационнаяПрограмма">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#содержитУпражнение"/>
      <owl:someValuesFrom rdf:resource="#Упражнение"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#имеетЦель"/>
      <owl:someValuesFrom rdf:resource="#ЦельРеабилитации"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#предназначенаДля"/>
      <owl:onClass rdf:resource="#Пациент"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#основанаНаИсторииБолезни"/>
      <owl:someValuesFrom rdf:resource="#ИсторияБолезни"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="ru">РеабилитационнаяПрограмма</rdfs:label>
  <rdfs:comment xml:lang="ru">Подобранная для пациента программа реабилитации (центральное понятие).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Пациент">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#имеетДанные"/>
      <owl:onClass rdf:resource="#ДанныеПациента"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="ru">Пациент</rdfs:label>
  <rdfs:comment xml:lang="ru">Человек, для которого подбирается программа. [добавлено при доработке]</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ПобочныйЭффект">
  <rdfs:subClassOf rdf:resource="#Эффект"/>
  <rdfs:label xml:lang="ru">ПобочныйЭффект</rdfs:label>
  <rdfs:comment xml:lang="ru">Нежелательный эффект.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Эффект">
  <rdfs:subClassOf rdf:resource="#СвойствоУпражнения"/>
  <rdfs:label xml:lang="ru">Эффект</rdfs:label>
  <rdfs:comment xml:lang="ru">Результат воздействия упражнения на организм.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ПрограммаСРиском">
  <rdfs:subClassOf rdf:resource="#РеабилитационнаяПрограмма"/>
  <rdfs:label xml:lang="ru">ПрограммаСРиском</rdfs:label>
  <rdfs:comment xml:lang="ru">Программа, в которой есть упражнение, не рекомендованное её пациенту. [выводимый класс: заполняется SWRL-правилами]</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Диагноз">
  <rdfs:subClassOf rdf:resource="#МедицинскаяИнформация"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#требуетЦели"/>
      <owl:someValuesFrom rdf:resource="#ЦельРеабилитации"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="ru">Диагноз</rdfs:label>
  <rdfs:comment xml:lang="ru">Установленный диагноз (код МКБ-10).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Производитель">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="ru">Производитель</rdfs:label>
  <rdfs:comment xml:lang="ru">Производитель инвентаря.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Упражнение">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#имеетТехникуВыполнения"/>
      <owl:someValuesFrom rdf:resource="#ТехникаВыполнения"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#имеетЭффект"/>
      <owl:someValuesFrom rdf:resource="#ЛечебныйЭффект"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="ru">Упражнение</rdfs:label>
  <rdfs:comment xml:lang="ru">Отдельное упражнение, входящее в программу.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#РеакцияПациента">
  <rdfs:subClassOf rdf:resource="#РезультатИспытания"/>
  <rdfs:label xml:lang="ru">РеакцияПациента</rdfs:label>
  <rdfs:comment xml:lang="ru">Реакция пациентов на упражнение в ходе испытания.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Противопоказание">
  <rdfs:subClassOf rdf:resource="#СвойствоУпражнения"/>
  <rdfs:label xml:lang="ru">Противопоказание</rdfs:label>
  <rdfs:comment xml:lang="ru">Состояние, при котором упражнение выполнять нельзя.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ИсторияБолезни">
  <rdfs:subClassOf rdf:resource="#МедицинскаяИнформация"/>
  <rdfs:label xml:lang="ru">ИсторияБолезни</rdfs:label>
  <rdfs:comment xml:lang="ru">Анамнез: перенесённые заболевания, травмы, операции.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Показание">
  <rdfs:subClassOf rdf:resource="#СвойствоУпражнения"/>
  <rdfs:label xml:lang="ru">Показание</rdfs:label>
  <rdfs:comment xml:lang="ru">Состояние, при котором упражнение рекомендовано.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Реабилитолог">
  <rdfs:subClassOf rdf:resource="#Специалист"/>
  <rdfs:label xml:lang="ru">Реабилитолог</rdfs:label>
  <rdfs:comment xml:lang="ru">Врач-реабилитолог.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Специалист">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="ru">Специалист</rdfs:label>
  <rdfs:comment xml:lang="ru">Тренер или реабилитолог, чей опыт используется при подборе программы.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ХарактеристикаИнвентаря">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="ru">ХарактеристикаИнвентаря</rdfs:label>
  <rdfs:comment xml:lang="ru">Технические характеристики инвентаря.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#СтатусИспытания">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Статус_Планируется"/>
        <rdf:Description rdf:about="#Статус_Проводится"/>
        <rdf:Description rdf:about="#Статус_Завершено"/>
        <rdf:Description rdf:about="#Статус_Приостановлено"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="ru">СтатусИспытания</rdfs:label>
  <rdfs:comment xml:lang="ru">Статус испытания (перечисление).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#УровеньБезопасности">
  <rdfs:subClassOf rdf:resource="#РезультатИспытания"/>
  <rdfs:label xml:lang="ru">УровеньБезопасности</rdfs:label>
  <rdfs:comment xml:lang="ru">Балл безопасности 1–5.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ПрофилактикаХроническихЗаболеваний">
  <rdfs:subClassOf rdf:resource="#УлучшениеКачестваЖизни"/>
  <rdfs:label xml:lang="ru">ПрофилактикаХроническихЗаболеваний</rdfs:label>
  <rdfs:comment xml:lang="ru">Профилактика прогрессирования и осложнений.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ИндивидуальнаяОсобенность">
  <rdfs:subClassOf rdf:resource="#МедицинскаяИнформация"/>
  <rdfs:label xml:lang="ru">ИндивидуальнаяОсобенность</rdfs:label>
  <rdfs:comment xml:lang="ru">Образ жизни, ограничения и т.п.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#СвойствоУпражнения">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="ru">СвойствоУпражнения</rdfs:label>
  <rdfs:comment xml:lang="ru">Группирующий класс для того, что описывает упражнение. [добавлено при доработке]</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ЦельРеабилитации">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="ru">ЦельРеабилитации</rdfs:label>
  <rdfs:comment xml:lang="ru">Цель, на которую направлена программа. [добавлено при доработке]</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Тренер">
  <rdfs:subClassOf rdf:resource="#Специалист"/>
  <rdfs:label xml:lang="ru">Тренер</rdfs:label>
  <rdfs:comment xml:lang="ru">Тренер ЛФК.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ЛечебныйЭффект">
  <rdfs:subClassOf rdf:resource="#Эффект"/>
  <rdfs:label xml:lang="ru">ЛечебныйЭффект</rdfs:label>
  <rdfs:comment xml:lang="ru">Ожидаемый положительный эффект. [добавлено при доработке]</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ПациентСОжирением">
  <rdfs:subClassOf rdf:resource="#Пациент"/>
  <rdfs:label xml:lang="ru">ПациентСОжирением</rdfs:label>
  <rdfs:comment xml:lang="ru">ИМТ ≥ 30 — ограничение сложности упражнений. [выводимый класс: заполняется SWRL-правилами]</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ПожилойПациент">
  <rdfs:subClassOf rdf:resource="#Пациент"/>
  <rdfs:label xml:lang="ru">ПожилойПациент</rdfs:label>
  <rdfs:comment xml:lang="ru">Возраст ≥ 60 лет — ограничение сложности упражнений. [выводимый класс: заполняется SWRL-правилами]</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#РезультатИспытания">
