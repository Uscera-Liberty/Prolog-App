<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/rehab/ontologies/2026/rehab-program"
         xmlns="http://www.semanticweb.org/rehab/ontologies/2026/rehab-program#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://www.semanticweb.org/rehab/ontologies/2026/rehab-program">
  <rdfs:label xml:lang="ru">Подбор оптимальной реабилитационной программы</rdfs:label>
  <rdfs:comment xml:lang="ru">Вариант 22. Рекомендательная система: по диагнозу и данным пациента подбирает упражнения, готовую программу, специалиста (реабилитолога/тренера) и спортивный инвентарь. Содержит SWRL-правила (вкладка SWRLTab).</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#имеетПроизводителя">
